{
  "info": {
    "name": "Restaurant Backend API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Individual Restaurant Online Delivery Backend API"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "adminToken", "value": "" },
    { "key": "customerToken", "value": "" },
    { "key": "deliveryToken", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Customer\",\n  \"email\": \"customer@test.com\",\n  \"phone\": \"9988776655\",\n  \"password\": \"cust123\"\n}"
            }
          }
        },
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@restaurant.com\",\n  \"password\": \"admin123\"\n}"
            }
          }
        },
        {
          "name": "Login Customer",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@test.com\",\n  \"password\": \"cust123\"\n}"
            }
          }
        },
        {
          "name": "Login Delivery Boy",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rider@test.com\",\n  \"password\": \"rider123\"\n}"
            }
          }
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/refresh-token",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"PASTE_REFRESH_TOKEN_HERE\"\n}"
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/logout",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "Create User (Admin)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/create-user",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rider Ahmed\",\n  \"email\": \"rider@test.com\",\n  \"phone\": \"9911223344\",\n  \"password\": \"rider123\",\n  \"role\": \"delivery_boy\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Menu (Public)",
      "item": [
        {
          "name": "Get Full Menu",
          "request": { "method": "GET", "url": "{{baseUrl}}/menu" }
        },
        {
          "name": "Get Category Items",
          "request": { "method": "GET", "url": "{{baseUrl}}/menu/1" }
        },
        {
          "name": "Get Item Detail",
          "request": { "method": "GET", "url": "{{baseUrl}}/menu/item/1" }
        }
      ]
    },
    {
      "name": "Admin - Categories",
      "item": [
        {
          "name": "Get All Categories",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/categories",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "Create Category",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/admin/categories",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "value": "New Category", "type": "text" },
                { "key": "sort_order", "value": "1", "type": "text" },
                { "key": "image", "type": "file", "src": "" }
              ]
            }
          }
        },
        {
          "name": "Update Category",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/admin/categories/1",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "value": "Updated Name", "type": "text" }
              ]
            }
          }
        },
        {
          "name": "Delete Category",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/admin/categories/1",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        }
      ]
    },
    {
      "name": "Admin - Menu Items",
      "item": [
        {
          "name": "Get All Items",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/items",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "Create Item",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/admin/items",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "category_id", "value": "1", "type": "text" },
                { "key": "name", "value": "New Item", "type": "text" },
                { "key": "description", "value": "Item description", "type": "text" },
                { "key": "price", "value": "250", "type": "text" },
                { "key": "prep_time", "value": "20", "type": "text" },
                { "key": "variations", "value": "[{\"name\":\"Half\",\"price\":150},{\"name\":\"Full\",\"price\":250}]", "type": "text" },
                { "key": "addons", "value": "[{\"name\":\"Naan\",\"price\":40}]", "type": "text" },
                { "key": "image", "type": "file", "src": "" }
              ]
            }
          }
        },
        {
          "name": "Toggle Availability",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/admin/items/1/toggle",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "Delete Item",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/admin/items/1",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        }
      ]
    },
    {
      "name": "Customer",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/customer/profile",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }]
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/customer/profile",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Name\"\n}"
            }
          }
        },
        {
          "name": "Add Address",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/customer/addresses",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Home\",\n  \"full_address\": \"123 Main Street, Block A\",\n  \"area\": \"Gulshan\",\n  \"city\": \"Karachi\",\n  \"lat\": 24.8607,\n  \"lng\": 67.0011,\n  \"is_default\": true\n}"
            }
          }
        },
        {
          "name": "Get Addresses",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/customer/addresses",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }]
          }
        },
        {
          "name": "Delete Address",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/customer/addresses/1",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }]
          }
        }
      ]
    },
    {
      "name": "Orders (Customer)",
      "item": [
        {
          "name": "Place Order",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/orders",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"delivery_address_id\": 1,\n  \"payment_method\": \"COD\",\n  \"delivery_notes\": \"Ring the bell\",\n  \"coupon_code\": \"SAVE20\",\n  \"items\": [\n    {\n      \"menu_item_id\": 1,\n      \"quantity\": 2,\n      \"variation_id\": 2,\n      \"addon_ids\": [1, 2]\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "My Orders",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/orders",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }]
          }
        },
        {
          "name": "Order Detail",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/orders/1",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }]
          }
        },
        {
          "name": "Cancel Order",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/orders/1/cancel",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Changed my mind\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Orders (Admin)",
      "item": [
        {
          "name": "All Orders",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/orders",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "Update Order Status",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/admin/orders/1/status",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"confirmed\"\n}"
            }
          }
        },
        {
          "name": "Assign Delivery Boy",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/admin/orders/1/assign",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"delivery_boy_id\": 3\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Delivery",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/delivery/profile",
            "header": [{ "key": "Authorization", "value": "Bearer {{deliveryToken}}" }]
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/delivery/profile",
            "header": [
              { "key": "Authorization", "value": "Bearer {{deliveryToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicle_type\": \"bike\"\n}"
            }
          }
        },
        {
          "name": "Toggle Online/Offline",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/delivery/toggle",
            "header": [{ "key": "Authorization", "value": "Bearer {{deliveryToken}}" }]
          }
        },
        {
          "name": "Update Location",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/delivery/location",
            "header": [
              { "key": "Authorization", "value": "Bearer {{deliveryToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lat\": 24.8607,\n  \"lng\": 67.0011\n}"
            }
          }
        },
        {
          "name": "My Assigned Orders",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/delivery/orders",
            "header": [{ "key": "Authorization", "value": "Bearer {{deliveryToken}}" }]
          }
        },
        {
          "name": "Update Delivery Status",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/delivery/orders/1",
            "header": [
              { "key": "Authorization", "value": "Bearer {{deliveryToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"delivered\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Coupons",
      "item": [
        {
          "name": "Create Coupon (Admin)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/admin/coupons",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"FLAT100\",\n  \"type\": \"flat\",\n  \"value\": 100,\n  \"min_order\": 500,\n  \"expiry_date\": \"2026-12-31\",\n  \"usage_limit\": 50\n}"
            }
          }
        },
        {
          "name": "All Coupons (Admin)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/coupons",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "Validate Coupon (Customer)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/coupons/validate/SAVE20?subtotal=500",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }]
          }
        }
      ]
    },
    {
      "name": "Admin Dashboard",
      "item": [
        {
          "name": "Dashboard Summary",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/dashboard",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "Sales Reports",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/reports?period=week",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "Top Selling Items",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/top-items",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "Delivery Boys List",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/delivery-boys",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "Get Config",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/config",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "Update Config",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/admin/config",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"My Restaurant\",\n  \"delivery_charge\": 50,\n  \"tax_percentage\": 5,\n  \"min_order_amount\": 200\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Upload",
      "item": [
        {
          "name": "Upload Image",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/upload/image",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "image", "type": "file", "src": "" }
              ]
            }
          }
        }
      ]
    }
  ]
}
